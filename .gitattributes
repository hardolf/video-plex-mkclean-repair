# Line endings are decided here rather than by each machine's core.autocrlf.
# text=auto: the repository always stores LF. eol=...: what the working copy gets.

* text=auto

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.csv   text eol=crlf
*.md    text eol=lf
*.txt   text eol=crlf

*.png   binary
*.xlsx  binary
*.xlsm  binary
*.mkv   binary
